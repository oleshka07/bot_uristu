# ── Copy this file to .env and fill in real values ──────────────────────────
# cp .env.example .env

# Anthropic / Claude API key — powers dossiers and recommendations.
# Get one at https://console.anthropic.com/. The app still runs without it
# (it falls back to rule-based recommendations), but AI features need it.
ANTHROPIC_API_KEY=

# Claude model used for AI features.
AI_MODEL=claude-opus-4-8

# Database connection.
# Local quick start (no Postgres needed): leave as the sqlite line.
# Production / docker-compose: the compose file overrides this with Postgres.
DATABASE_URL=sqlite:///./networking.db
# DATABASE_URL=postgresql+psycopg://networking:networking@db:5432/networking

# How many people the dashboard suggests contacting each day.
DAILY_SUGGESTIONS=5

# Look-ahead window (days) for upcoming birthdays / key dates.
UPCOMING_WINDOW_DAYS=14

# CORS — comma separated list of allowed origins ("*" allows all).
CORS_ORIGINS=*

# ── Google integration (Gmail + Calendar auto-sync) ─────────────────────────
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials and enable the Gmail API
# and Google Calendar API. Add the redirect URI below to the client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must EXACTLY match an authorised redirect URI on the OAuth client.
# Local: http://localhost:8000/api/integrations/google/callback
# Prod:  https://your-domain/api/integrations/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# How many days back to pull emails / calendar events when syncing.
SYNC_WINDOW_DAYS=120

# ── Daily automation (background scheduler) ─────────────────────────────────
# Turn on the in-process scheduler that runs the daily job (warmth refresh,
# Google sync, digest email). For multi-process setups prefer a cron job
# calling:  python -m app.run_daily
SCHEDULER_ENABLED=false
DAILY_RUN_HOUR=8
# Where to send the daily digest. Defaults to your connected Google account.
DIGEST_EMAIL_TO=

# ── Social scraping provider (optional, for Instagram/LinkedIn) ─────────────
# A rendering/scraping API used to fetch JS-heavy pages. Supported: scrapingbee.
SCRAPER_PROVIDER=
SCRAPER_API_KEY=
